# ============================================================
# AI Security Platform — Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# Flask
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
FLASK_ENV=development
FLASK_PORT=5000

# Admin credentials (hashed at runtime — set plain text here for initial setup)
ADMIN_USERNAME=vignesh
ADMIN_PASSWORD=password

# YOLO
YOLO_MODEL_PATH=models/yolo/best.pt
YOLO_DATA_PATH=AICS.v1i.yolov11/data.yaml
YOLO_CONFIDENCE=0.50
YOLO_IOU=0.45

# Face Recognition
FACE_MATCH_THRESHOLD=0.50
CAMERA_INDEX=0
FRAME_INTERVAL=2

# NIDS
NIDS_MODEL_PATH=models/realtime_model.pkl
NIDS_SCALER_PATH=models/realtime_scaler.pkl
NIDS_FEATURES_PATH=models/realtime_features.pkl
SCAN_PORT_THRESHOLD=20
SCAN_TIME_WINDOW=10
FLOW_TIMEOUT=5

# Response / Blocking
AUTO_BLOCK_ENABLED=false
RESPONSE_HIGH_THRESHOLD=0.85
RESPONSE_CRITICAL_THRESHOLD=0.95

# Database
DATABASE_PATH=data/security.db

# Session
SESSION_TIMEOUT_MINUTES=60
